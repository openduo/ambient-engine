+void llama_memory_recurrent::clear_state_snapshot_dsts(llama_seq_id seq_id) {
+    if (seq_id < 0) {
+        snapshot_dsts.clear();
+    } else {
+        snapshot_dsts.erase(seq_id);
+    }
+    if (seq_id < 0 || selected_dst_seq == seq_id) {
+        selected_dst_seq  = -1;
+        selected_dst_slot = -1;
+    }
