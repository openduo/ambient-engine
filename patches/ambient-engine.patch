+    GGML_ASSERT(read_rows->ne[0] == n_seqs);
+    GGML_ASSERT(K >= 1);
+    GGML_ASSERT(write_states->ne[0] == S_v * S_v * H);
+    GGML_ASSERT(write_states->ne[1] == n_seqs);
+    GGML_ASSERT(write_states->ne[2] == MIN(n_tokens, K));
+
+    // Preserve the packed attention prefix used by the existing consumers,
+    // but omit the K*D snapshot tail: the backend writes it to states.
+    const int64_t ne[4] = { S_v * H, n_tokens * n_seqs, 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, (int32_t) K);
+
+    result->op     = GGML_OP_GATED_DELTA_NET;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = v;
+    result->src[3] = g;
+    result->src[4] = beta;
+    result->src[5] = states;
+    result->src[6] = read_rows;
+    result->src[9] = write_states;
+
+    return result;
+}
