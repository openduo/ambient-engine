+
+void llama_memory_recurrent::journal_check_defined(llama_seq_id seq_id) const {
+    if (seq_id >= 0 && (uint32_t) seq_id < n_seq_max && state_undefined[seq_id]) {
+        GGML_ABORT("%s: the recurrent state of seq %d is undefined after a failed ubatch; "
+                "remove or restore the sequence before using it", __func__, seq_id);
+    }
+}
+
+void llama_memory_recurrent::journal_apply(const llama_ubatch & ubatch) {
+    if (!journal) {
+        return;
+    }
+
+    for (uint32_t s = 0; s < ubatch.n_seqs; ++s) {
+        const uint32_t i = s*ubatch.n_seq_tokens;
+        for (int32_t j = 0; j < ubatch.n_seq_id[i]; ++j) {
+            journal_check_defined(ubatch.seq_id[i][j]);
+        }
+    }
+
+    // The graph applies the pending entries of every source row before it reads
+    // S, once per row: cells copied from one shared cell name the same row, and
+    // the commit is in place. rs_z is cleared instead (its cells start from a
+    // zero state). An idle cell of the range that only copies onto itself keeps
+    // its pending entries.
+    journal_plan.assign(2*n, 0);
+    journal_kept.assign(n, false);
+    for (uint32_t i = 0; i < n; ++i) {
+        const int32_t row = cells[head + i].src0;
+        GGML_ASSERT(row >= 0 && (uint32_t) row < size);
+        journal_plan[2*i + 0] = row;
+    }
+    for (uint32_t i = ubatch.n_seqs; i < n; ++i) {
+        const int32_t row = journal_plan[2*i];
+        bool kept = row == (int32_t) (head + i) && row != rs_z;
+        for (uint32_t k = 0; kept && k < n; ++k) {
+            kept = k == i || journal_plan[2*k] != row;
+        }
+        journal_kept[i] = kept;
+    }
+    std::vector<bool> committed(size, false);
+    for (uint32_t i = 0; i < n; ++i) {
+        const int32_t row = journal_plan[2*i];
+        if (journal_kept[i] || row == rs_z || committed[row]) {
+            continue;
+        }
+        journal_plan[2*i + 1] = (int32_t) journal_count[row];
+        committed[row] = true;
+        journal_count[row] = 0;
+    }
+
+    // Rows written by this ubatch: the extra rows receive committed copies;
+    // each sequence's row receives its base and the journal of its last tokens.
+    // An in-pass snapshot ubatch stores its final state as the base (no rollback
+    // is allowed after it, as rs_invalid_from records).
+    for (uint32_t i = 0; i < n; ++i) {
+        if (!journal_kept[i]) {
+            journal_count[head + i] = 0;
+        }
+    }
+    if (state_snapshot_request(ubatch) == nullptr) {
+        const uint32_t count = std::min<uint32_t>(ubatch.n_seq_tokens, n_journal);
+        for (uint32_t s = 0; s < ubatch.n_seqs; ++s) {
+            journal_count[head + s] = count;
+        }
+    }
+}
+
+void llama_memory_recurrent::journal_ubatch_failed(const llama_ubatch & ubatch) {
+    if (!journal) {
+        return;
+    }
+    // The graph may have committed entries, partly or fully, and may have written some
+    // bases: nothing about these rows is known any more. A source row whose
+    // entries were taken over by the plan may belong to another sequence too.
+    auto mark_undefined = [&](const mem_cell & cell) {
+        for (const llama_seq_id seq_id : cell.seq_id) {
+            if (seq_id >= 0 && (uint32_t) seq_id < n_seq_max) {
+                state_undefined[seq_id] = true;
+            }
+        }
+    };
+    for (size_t i = 0; i < journal_plan.size()/2; ++i) {
+        if (journal_plan[2*i + 1] > 0) {
+            mark_undefined(cells[journal_plan[2*i + 0]]);
+        }
+    }
+    // a kept cell is only copied onto itself, which leaves its base as it was
+    for (uint32_t i = 0; i < n; ++i) {
+        if (i >= journal_kept.size() || !journal_kept[i]) {
+            journal_count[head + i] = 0;
+        }
+    }
+    for (uint32_t i = 0; i < ubatch.n_tokens; ++i) {
+        for (int32_t j = 0; j < ubatch.n_seq_id[i]; ++j) {
+            const llama_seq_id seq_id = ubatch.seq_id[i][j];
+            if (seq_id >= 0 && (uint32_t) seq_id < n_seq_max) {
+                state_undefined[seq_id] = true;
+            }
+        }
+    }
+}
