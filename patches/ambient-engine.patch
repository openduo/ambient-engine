+size_t llama_context::state_seq_adopt_staging(llama_seq_id seq_id, uint8_t * dst, size_t size, llama_state_seq_flags flags) {
+    auto * recurrent = llama_get_recurrent_memory(memory.get());
+    const int32_t slot = recurrent->selected_snapshot_dst(seq_id);
+
+    auto st = std::find_if(state_stagings.begin(), state_stagings.end(), [&](const state_staging & cur) {
+        return cur.seq_id == seq_id && (int32_t) cur.slot == slot;
+    });
+    GGML_ASSERT(st != state_stagings.end() && st->filled);
+
+    // the same pool decision as state_seq_get_data
+    llama_seq_id storage_id;
+    bool reuse_device_slot = false;
+    if (!device_state_free.empty()) {
+        storage_id = *device_state_free.begin();
+        device_state_free.erase(device_state_free.begin());
+        reuse_device_slot = true;
+    } else if (mem_storage.size() >= cparams.n_state_device_max) {
+        LLAMA_LOG_DEBUG("%s: device checkpoint pool is full (%zu slots)\n", __func__, mem_storage.size());
+        return 0;
+    } else {
+        storage_id = next_device_state_id++;
+        if (next_device_state_id >= 0) {
+            next_device_state_id = std::numeric_limits<llama_seq_id>::min();
+        }
+    }
+
+    // The serialized header and metadata are those of a device save; the tensor
+    // records must be exactly the snapshot buffer's tensors.
+    class llama_io_write_meta : public llama_io_write_i {
+    public:
+        llama_io_write_meta(uint8_t * p, size_t len) : ptr(p), buf_size(len) {}
+
+        void write(const void * src, size_t n) override {
+            if (n > buf_size) {
+                throw std::runtime_error("unexpectedly reached end of buffer");
+            }
+            memcpy(ptr, src, n);
+            ptr += n;
+            size_written += n;
+            buf_size -= n;
+        }
+
+        void write_tensor(ggml_tensor * tensor, size_t offset, size_t n) override {
+            if (offset != 0 || n != ggml_nbytes(tensor)) {
+                throw std::runtime_error("in-pass snapshot record is not a whole buffer tensor");
+            }
+            tensors.push_back(tensor);
+        }
+
+        size_t n_bytes() override {
+            return size_written;
+        }
+
+        bool tensor_writes_immediate() const override {
+            return false;
+        }
+
+        std::vector<ggml_tensor *> tensors;
+
+    private:
+        uint8_t * ptr;
+        size_t buf_size;
+        size_t size_written = 0;
+    };
+
+    try {
+        llama_io_write_meta io(dst, size);
+        io.write(&io_magic, sizeof(io_magic));
+        io.write(&storage_id, sizeof(storage_id));
+
+        const size_t result = state_seq_write_data(io, seq_id, flags);
+
+        // a restore copies the buffer's tensors to the records by position, per buffer type
+        std::map<ggml_backend_buffer_type_t, std::vector<ggml_tensor *>> got;
+        for (ggml_tensor * t : io.tensors) {
+            got[ggml_backend_buffer_get_type(t->buffer)].push_back(t);
+        }
+        bool match = got.size() == st->bufs.size();
+        for (const auto & [buft, mbuf] : st->bufs) {
+            const auto it = got.find(buft);
+            match = match && it != got.end() && it->second == mbuf.cpy;
+        }
+        if (!match) {
+            throw std::runtime_error("in-pass snapshot records do not match its buffer");
+        }
+
+        // the entry takes the snapshot buffer; its previous buffer (if any) is released with the staging
+        std::swap(mem_storage[storage_id], st->bufs);
+        recurrent->clear_state_snapshot_dst(seq_id, (uint32_t) slot);
