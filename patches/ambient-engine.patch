+namespace {
+
+// Bounded CPU-side cache of tokenized chat-prompt segments. The fixed size
+// keeps memory use independent of conversation length.
+class chat_token_lru {
+    struct value {
+        llama_tokens tokens;
+        std::list<std::string>::iterator lru_it;
+        size_t bytes;
+    };
+
+    static constexpr size_t max_bytes   = 64u * 1024u * 1024u;
+    static constexpr size_t max_entries = 2048;
+
+    const llama_vocab * cache_vocab = nullptr;
+    size_t bytes = 0;
+    std::list<std::string> lru;
+    std::unordered_map<std::string, value> entries;
+    std::mutex mutex;
+
+    void reset_for_vocab(const llama_vocab * vocab) {
+        if (cache_vocab != vocab) {
+            entries.clear();
+            lru.clear();
+            bytes = 0;
+            cache_vocab = vocab;
+        }
+    }
+
+public:
+    bool get(const llama_vocab * vocab, const std::string & key, llama_tokens & result) {
+        std::lock_guard<std::mutex> lock(mutex);
+        reset_for_vocab(vocab);
+        auto it = entries.find(key);
+        if (it == entries.end()) {
+            return false;
+        }
+        lru.splice(lru.begin(), lru, it->second.lru_it);
+        result = it->second.tokens;
+        return true;
+    }
+
+    void put(const llama_vocab * vocab, std::string key, const llama_tokens & tokens) {
+        const size_t entry_bytes = key.size() + tokens.size() * sizeof(llama_token);
+        if (entry_bytes > max_bytes) {
+            return;
+        }
+
+        std::lock_guard<std::mutex> lock(mutex);
+        reset_for_vocab(vocab);
+        auto found = entries.find(key);
+        if (found != entries.end()) {
+            lru.splice(lru.begin(), lru, found->second.lru_it);
+            return;
+        }
+
+        lru.push_front(key);
+        auto inserted = entries.emplace(std::move(key), value { tokens, lru.begin(), entry_bytes });
+        if (!inserted.second) {
+            lru.pop_front();
+            return;
+        }
+        bytes += entry_bytes;
+
+        while (bytes > max_bytes || entries.size() > max_entries) {
+            auto it = entries.find(lru.back());
+            GGML_ASSERT(it != entries.end());
+            bytes -= it->second.bytes;
+            entries.erase(it);
+            lru.pop_back();
+        }
+    }
+};
+
+chat_token_lru & get_chat_token_lru() {
+    static chat_token_lru cache;
+    return cache;
+}
