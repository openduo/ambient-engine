+        release_state_snapshot();
+        return result;
+    } catch (const std::exception & err) {
+        release_state_snapshot();
+        if (reuse_device_slot) {
+            device_state_free.insert(storage_id);
+        } else {
+            mem_storage.erase(storage_id);
+        }
+        LLAMA_LOG_ERROR("%s: error saving state: %s\n", __func__, err.what());
+        return 0;
+    }
+}
