+void llama_memory_recurrent::clear_state_snapshot_dst(llama_seq_id seq_id, uint32_t slot) {
+    const auto it = snapshot_dsts.find(seq_id);
+    if (it != snapshot_dsts.end() && slot < it->second.size()) {
+        it->second[slot].r.clear();
+        it->second[slot].s.clear();
+    }
+}
+
+const llama_memory_recurrent::state_snapshot_dst * llama_memory_recurrent::state_snapshot_dst_for(
+        const llama_ubatch & ubatch, uint32_t slot) const {
+    if (!journal || state_snapshot_request(ubatch) == nullptr) {
+        return nullptr;
+    }
+    const auto it = snapshot_dsts.find(ubatch.seq_id[0][0]);
+    if (it == snapshot_dsts.end() || slot >= it->second.size() || it->second[slot].s.empty()) {
+        return nullptr;
+    }
+    return &it->second[slot];
+}
