+// Normal rollback layout: plane s holds the state after token n_tokens-1-s.
+static std::vector<int32_t> trailing_snapshot_indices(int32_t K, int32_t n_tokens) {
+    std::vector<int32_t> result(K, -1);
+    for (int32_t s = 0; s < K && s < n_tokens; ++s) {
+        result[s] = n_tokens - 1 - s;
+    }
+    return result;
+}
+
+void llama_memory_recurrent::set_state_snapshots(
+        llama_seq_id seq_id, const llama_pos * positions, size_t count) {
+    if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+        return;
+    }
+
+    auto & dst = state_snapshots[seq_id];
+    dst.clear();
+    const size_t n = std::min<size_t>(count, n_rs_seq);
+    if (positions != nullptr) {
+        dst.assign(positions, positions + n);
+    }
+    if (dst.empty()) {
+        state_snapshots.erase(seq_id);
+    }
+}
+
+void llama_memory_recurrent::clear_state_snapshot_requests() {
+    state_snapshots.clear();
+}
+
+bool llama_memory_recurrent::has_state_snapshots() const {
+    return !state_snapshots.empty();
+}
+
+const std::vector<llama_pos> * llama_memory_recurrent::state_snapshot_request(const llama_ubatch & ubatch) const {
+    // Custom planes are shared by every sequence of a ubatch, so they are
+    // only used for a ubatch of exactly one unshared sequence.
+    if (state_snapshots.empty() || ubatch.n_seqs != 1 || ubatch.n_seq_tokens == 0 ||
+            ubatch.seq_id == nullptr || ubatch.n_seq_id == nullptr || ubatch.n_seq_id[0] != 1) {
+        return nullptr;
+    }
+
+    const auto it = state_snapshots.find(ubatch.seq_id[0][0]);
+    return it == state_snapshots.end() ? nullptr : &it->second;
+}
+
+std::vector<int32_t> llama_memory_recurrent::state_snapshot_indices(const llama_ubatch & ubatch) const {
+    const int32_t K = (int32_t) n_rs_seq + 1;
+    const int32_t n_tokens = (int32_t) ubatch.n_seq_tokens;
+    std::vector<int32_t> result = trailing_snapshot_indices(K, n_tokens);
+
+    const auto * request = state_snapshot_request(ubatch);
+    if (request == nullptr) {
+        return result;
+    }
+
+    // Plane 0 stays the post-ubatch state. Every other plane is written only
+    // for a captured position; unmatched planes are left unwritten.
+    std::fill(result.begin() + 1, result.end(), -1);
+
+    // The graph copies only the first min(n_tokens, K) planes to the cache.
+    const size_t n_written = (size_t) std::min(n_tokens, K);
+
+    for (size_t s = 0; s < request->size() && s + 1 < n_written; ++s) {
+        const llama_pos wanted = (*request)[s] - 1;
+        int32_t token_idx = -1;
+        for (int32_t t = 0; t < n_tokens; ++t) {
+            if (ubatch.pos[t] == wanted) {
+                token_idx = t;
+                break;
+            }
+        }
+        if (token_idx < 0) {
+            continue;
+        }
+        // The kernel writes a token's state to one plane only (the last match);
+        // a token already owned by another plane (plane 0 included) is not captured.
+        if (std::find(result.begin(), result.end(), token_idx) != result.end()) {
+            continue;
+        }
+        result[s + 1] = token_idx;
+    }
+
+    return result;
+}
+
+void llama_memory_recurrent::erase_state_snapshot_records(llama_seq_id seq_id) {
+    if (seq_id < 0) {
+        state_snapshot_records.clear();
+    } else {
+        state_snapshot_records.erase(seq_id);
+    }
+}
+
+void llama_memory_recurrent::record_state_snapshots(const llama_ubatch & ubatch) {
+    if (n_rs_seq == 0 || ubatch.n_seq_tokens == 0) {
+        return;
+    }
+
+    const uint32_t K = n_rs_seq + 1;
+    const uint32_t n_written = std::min<uint32_t>(ubatch.n_seq_tokens, K);
+    const bool custom = state_snapshot_request(ubatch) != nullptr;
+    const std::vector<int32_t> indices = custom ? state_snapshot_indices(ubatch) : std::vector<int32_t>();
+
+    for (uint32_t s = 0; s < ubatch.n_seqs; ++s) {
+        const uint32_t i = s*ubatch.n_seq_tokens;
+        for (int32_t j = 0; j < ubatch.n_seq_id[i]; ++j) {
+            const llama_seq_id seq_id = ubatch.seq_id[i][j];
+            if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max) {
+                continue;
+            }
+            const int32_t cell = cells[seq_id].tail;
+
+            // Planes of this cell are rewritten now; no other record may refer to them.
+            for (auto it = state_snapshot_records.begin(); it != state_snapshot_records.end();) {
+                if (it->first == seq_id || it->second.cell == cell) {
+                    it = state_snapshot_records.erase(it);
+                } else {
+                    ++it;
+                }
+            }
+
+            if (!custom) {
+                // Planes [1, n_written) now hold trailing-token states again.
+                rs_invalid_from[seq_id] = std::max(rs_invalid_from[seq_id], n_written);
+                continue;
+            }
+
+            // Planes 1..n_rs_seq now hold snapshots or stale data.
+            rs_invalid_from[seq_id] = 1;
+
+            state_snapshot_record rec;
+            rec.cell     = cell;
+            rec.last_pos = ubatch.pos[i + ubatch.n_seq_tokens - 1];
+            rec.plane_pos.assign(K, -1);
+            for (uint32_t p = 1; p < K; ++p) {
+                if (indices[p] >= 0) {
+                    rec.plane_pos[p] = ubatch.pos[i + indices[p]];
+                }
+            }
+            state_snapshot_records[seq_id] = std::move(rec);
+        }
+    }
+}
+
+bool llama_memory_recurrent::select_state_snapshot(
+        llama_seq_id seq_id, uint32_t idx, llama_pos pos, llama_pos & old_pos) {
+    if (seq_id < 0 || (uint32_t) seq_id >= n_seq_max || idx == 0 || idx > n_rs_seq) {
+        return false;
+    }
+    // a pending rollback already redirects the next read of this sequence
+    if (rs_idx[seq_id] != 0) {
+        return false;
+    }
+
+    const auto it = state_snapshot_records.find(seq_id);
+    if (it == state_snapshot_records.end()) {
+        return false;
+    }
+    const auto & rec = it->second;
+
+    const int32_t tail = cells[seq_id].tail;
+    if (tail < 0 || tail != rec.cell || cells[tail].pos != rec.last_pos ||
+            (cells[tail].src >= 0 && cells[tail].src != tail)) {
+        return false;
+    }
+    if (idx >= rec.plane_pos.size() || rec.plane_pos[idx] < 0 || rec.plane_pos[idx] != pos) {
+        return false;
+    }
+
+    old_pos = cells[tail].pos;
+    set_rs_idx(seq_id, idx);
+    cells[tail].pos = pos;
+    return true;
+}
+
+void llama_memory_recurrent::restore_state_snapshot(llama_seq_id seq_id, llama_pos pos) {
+    GGML_ASSERT(seq_id >= 0 && (uint32_t) seq_id < n_seq_max);
+    const int32_t tail = cells[seq_id].tail;
+    GGML_ASSERT(tail >= 0);
+    cells[tail].pos = pos;
+    set_rs_idx(seq_id, 0);
+}
