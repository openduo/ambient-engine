--- a/ggml/src/ggml-cuda/fwht.cu
+++ b/ggml/src/ggml-cuda/fwht.cu
@@ -1,5 +1,7 @@
 #include "common.cuh"
 #include "fwht.cuh"
+#include "mmq.cuh"
+#include "unary.cuh"
 
