+void llama_memory_recurrent::journal_commit_row(int32_t il, uint32_t row, uint32_t count, ggml_tensor * dst) const {
+    // dst: one contiguous S row (n_embd_s floats) on a device; it runs between decodes.
+    // One persistent graph with one commit node: its tensors are re-pointed at
+    // every commit, so a backend's graph cache, keyed by the first node, holds
+    // a single entry for it whatever the number of commits.
+    GGML_ASSERT(count > 0 && count <= n_journal);
+    GGML_ASSERT(ggml_nelements(dst) == (int64_t) hparams.n_embd_s() && dst->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous(dst) && dst->buffer != nullptr && dst->data != nullptr);
+
+    ggml_tensor * j = j_l[il];
+
+    if (journal_commit_gf == nullptr) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ 3*ggml_tensor_overhead(), // st, jr, c
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        journal_commit_ctx.reset(ggml_init(params));
+        GGML_ASSERT(journal_commit_ctx);
+        ggml_context * ctx = journal_commit_ctx.get();
+
+        journal_commit_st = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, hparams.n_embd_s(), 1);
+        journal_commit_jr = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, j->ne[0], 1);
+        journal_commit_c  = ggml_gated_delta_net_commit(ctx, journal_commit_st, journal_commit_jr, nullptr,
+                journal_s_v, journal_h_k, journal_h_v, (int) n_journal, (int) count);
+
+        // the graph holds every tensor of its context
+        size_t n_tensors = 0;
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != nullptr; t = ggml_get_next_tensor(ctx, t)) {
+            ++n_tensors;
+        }
+        ggml_init_params gparams = {
+            /*.mem_size   =*/ ggml_graph_overhead_custom(n_tensors, false),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        journal_commit_gctx.reset(ggml_init(gparams));
+        GGML_ASSERT(journal_commit_gctx);
+        journal_commit_gf = ggml_new_graph_custom(journal_commit_gctx.get(), n_tensors, false);
+        ggml_build_forward_expand(journal_commit_gf, journal_commit_c);
+    }
+
+    GGML_ASSERT(ggml_nbytes(journal_commit_jr) == (size_t) j->nb[1]);
+
+    journal_commit_st->buffer = dst->buffer;
+    journal_commit_st->data   = dst->data;
+    journal_commit_jr->buffer = j->buffer;
+    journal_commit_jr->data   = (char *) j->data + (size_t) row*j->nb[1];
+    journal_commit_c->buffer  = journal_commit_st->buffer;
+    journal_commit_c->data    = journal_commit_st->data;
+    ggml_gated_delta_net_commit_set_count(journal_commit_c, (int) count);
+
+    ggml_backend_t backend = journal_backend_for(dst);
+    if (ggml_backend_graph_compute(backend, journal_commit_gf) != GGML_STATUS_SUCCESS) {
+        GGML_ABORT("%s: failed to commit the recurrent journal", __func__);
+    }
+    ggml_backend_synchronize(backend);
+}
+
+ggml_tensor * llama_memory_recurrent::journal_scratch_row(int32_t il, uint32_t row) const {
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(s_l[il]->buffer);
+    if (journal_scratch == nullptr || ggml_backend_buffer_get_type(journal_scratch_buf.get()) != buft) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        journal_scratch_buf.reset();
+        journal_scratch_ctx.reset(ggml_init(params));
+        journal_scratch = ggml_new_tensor_1d(journal_scratch_ctx.get(), GGML_TYPE_F32, hparams.n_embd_s());
+        journal_scratch_buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(journal_scratch_ctx.get(), buft));
+        if (!journal_scratch_buf) {
+            throw std::runtime_error("failed to allocate the recurrent journal scratch row");
+        }
+    }
+
+    // copy the base row
+    ggml_init_params params = {
+        /*.mem_size   =*/ ggml_tensor_overhead(),
+        /*.mem_buffer =*/ NULL,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx { ggml_init(params) };
+    ggml_tensor * src = ggml_view_1d(ctx.get(), s_l[il], hparams.n_embd_s(), (size_t) row*s_l[il]->nb[1]);
+    ggml_backend_view_init(src);
+    ggml_backend_tensor_copy(src, journal_scratch);
+
+    return journal_scratch;
+}
+
+void llama_memory_recurrent::journal_commit_copies(llama_seq_id seq_id,
+        const std::vector<ggml_tensor *> & org, const std::vector<ggml_tensor *> & cpy) const {
+    if (!journal) {
+        return;
+    }
+    GGML_UNUSED(seq_id);
+    GGML_ASSERT(org.size() == cpy.size());
+
+    const uint32_t n_layer = hparams.n_layer();
+    for (size_t k = 0; k < org.size(); ++k) {
+        for (uint32_t il = 0; il < n_layer; ++il) {
+            if (s_l[il] == nullptr || org[k]->view_src != s_l[il]) {
+                continue;
+            }
+            // the copy holds whole base rows starting at this row
+            const size_t row_size = s_l[il]->nb[1];
+            GGML_ASSERT(org[k]->view_offs % row_size == 0 && ggml_nbytes(cpy[k]) % row_size == 0);
+            const uint32_t row0   = (uint32_t) (org[k]->view_offs / row_size);
+            const uint32_t n_rows = (uint32_t) (ggml_nbytes(cpy[k]) / row_size);
+            for (uint32_t r = 0; r < n_rows; ++r) {
+                const uint32_t count = journal_count[row0 + r];
+                if (count == 0) {
+                    continue;
+                }
+                ggml_init_params params = {
+                    /*.mem_size   =*/ ggml_tensor_overhead(),
+                    /*.mem_buffer =*/ NULL,
+                    /*.no_alloc   =*/ true,
+                };
+                ggml_context_ptr ctx { ggml_init(params) };
+                ggml_tensor * dst = ggml_view_1d(ctx.get(), cpy[k], hparams.n_embd_s(), (size_t) r*row_size);
+                ggml_backend_view_init(dst);
+                journal_commit_row((int32_t) il, row0 + r, count, dst);
+            }
+        }
+    }
+}
+
+void llama_memory_recurrent::state_write_data_journal(llama_io_write_i & io,
+        const std::vector<std::pair<uint32_t, uint32_t>> & cell_ranges,
+        const std::vector<std::pair<uint32_t, uint32_t>> & s_rows,
+        const state_snapshot_dst * staged) const {
+    const uint32_t s_trans = 0;
+    const uint32_t n_layer = hparams.n_layer();
+
+    io.write(&s_trans, sizeof(s_trans));
+    io.write(&n_layer, sizeof(n_layer));
+
+    // R: same records as state_write_data
+    for (uint32_t il = 0; il < n_layer; ++il) {
+        if (r_l[il] == nullptr) continue;
+
+        const int32_t r_type_i = (int32_t)r_l[il]->type;
+        io.write(&r_type_i, sizeof(r_type_i));
+
+        const uint64_t r_size_row = ggml_row_size(r_l[il]->type, hparams.n_embd_r());
+        io.write(&r_size_row, sizeof(r_size_row));
+
+        if (staged != nullptr) {
+            io.write_tensor(staged->r[il], 0, r_size_row);
+            continue;
+        }
+        for (const auto & range : cell_ranges) {
+            const size_t range_size = range.second - range.first;
+            io.write_tensor(r_l[il], range.first * r_size_row, range_size * r_size_row);
+        }
+    }
+
+    // S: the logical state of each cell. Copies made after the io (device) and
+    // size queries take the base rows; the device caller applies the pending
+    // entries onto its copies (journal_commit_copies). Immediate writes
+    // are committed into a device scratch row first.
+    const bool commit_now = io.stores_tensor_data() && io.tensor_writes_immediate();
+    std::vector<uint8_t> scratch_data;
+
+    for (uint32_t il = 0; il < n_layer; ++il) {
+        if (s_l[il] == nullptr) continue;
+
+        const int32_t s_type_i = (int32_t)s_l[il]->type;
+        io.write(&s_type_i, sizeof(s_type_i));
+
+        const uint64_t s_size_row = ggml_row_size(s_l[il]->type, hparams.n_embd_s());
+        io.write(&s_size_row, sizeof(s_size_row));
+
+        if (staged != nullptr) {
+            io.write_tensor(staged->s[il], 0, s_size_row);
+            continue;
+        }
+
+        // consecutive rows are written as one range, as state_write_data does
+        size_t k = 0;
+        while (k < s_rows.size()) {
+            const uint32_t row = s_rows[k].first;
+            if (commit_now && s_rows[k].second > 0) {
+                ggml_tensor * scratch = journal_scratch_row(il, row);
+                journal_commit_row((int32_t) il, row, s_rows[k].second, scratch);
+                // read the shared scratch row now: a host io defers write_tensor
+                // reads to its destruction, when the row holds a later commit
+                scratch_data.resize(s_size_row);
+                ggml_backend_tensor_get(scratch, scratch_data.data(), 0, s_size_row);
+                io.write(scratch_data.data(), s_size_row);
+                ++k;
+                continue;
+            }
+            size_t n_rows = 1;
+            while (k + n_rows < s_rows.size() && s_rows[k + n_rows].first == row + n_rows &&
+                    !(commit_now && s_rows[k + n_rows].second > 0)) {
+                ++n_rows;
+            }
+            io.write_tensor(s_l[il], row * s_size_row, n_rows * s_size_row);
+            k += n_rows;
+        }
+    }
+}
