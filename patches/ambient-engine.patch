+// Applies journal entries to base states in place (ggml_gated_delta_net_commit).
+// Block (col, h, pair); thread i owns element i of state column col of v-head h.
+// The update must round exactly as gated_delta_net_cuda's `g_val * s + k * delta_col`,
+// which nvcc contracts to fma(g_val, s, k * delta_col). Left to the compiler, the same
+// expression here can contract to fma(k, delta_col, g_val * s), so the form is spelled out.
+static __global__ void gated_delta_net_commit_cuda(
+        float * states, int64_t state_row_stride,
+        const float * journal, int64_t journal_row_stride, int64_t journal_entry,
+        const int32_t * plan, int count, int S_v, int H_k, int H_v) {
+    const int col = blockIdx.x;
+    const int h   = blockIdx.y;
+    const int i   = threadIdx.x;
+
+    int64_t row = 0;
+    int     n   = count;
+    if (plan != nullptr) {
+        row = plan[2 * blockIdx.z];
+        n   = plan[2 * blockIdx.z + 1];
+    }
+    if (n <= 0) {
+        return;
+    }
+
+    // state is stored transposed: M[col][i] = S[i][col], row col is contiguous
+    float * s_col = states + row * state_row_stride + ((int64_t) h * S_v + col) * S_v;
