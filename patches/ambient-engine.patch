+llama_tokens tokenize_chat_prompt_cached(
+        const llama_vocab * vocab,
+        const std::string & prompt,
+        const common_chat_msg_delimiters & delimiters,
+        bool add_special) {
+    std::vector<size_t> starts { 0 };
+
+    // Only split on delimiters which start with an actual special token. This
+    // is an exact tokenizer boundary: no BPE/pre-tokenizer match can span it.
+    // Templates with ordinary-text delimiters safely fall back to one segment.
+    // Two tokenizer behaviours break that equivalence, so they also fall back:
+    // a token appended after the text (EOS or SEP), which would land after the
+    // first segment, and a left-stripping special token, which removes
+    // whitespace that belongs to the previous segment.
+    const bool appends_special = add_special &&
+        (llama_vocab_get_add_eos(vocab) || llama_vocab_get_add_sep(vocab) ||
+         llama_vocab_type(vocab) == LLAMA_VOCAB_TYPE_WPM);
+    for (const auto & delimiter : delimiters.delimiters) {
+        if (appends_special) {
+            break;
+        }
+        if (delimiter.delimiter.empty() || delimiter.tokens.empty()) {
+            continue;
+        }
+        const llama_token first = delimiter.tokens.front();
+        const auto attr = llama_vocab_get_attr(vocab, first);
+        if ((attr & (LLAMA_TOKEN_ATTR_CONTROL | LLAMA_TOKEN_ATTR_USER_DEFINED)) == 0 ||
+                (attr & LLAMA_TOKEN_ATTR_LSTRIP) != 0) {
+            continue;
+        }
+        const std::string piece = common_token_to_piece(vocab, first, true);
+        if (piece.empty() || delimiter.delimiter.compare(0, piece.size(), piece) != 0) {
+            continue;
+        }
+
+        for (size_t pos = prompt.find(delimiter.delimiter);
+                pos != std::string::npos;
+                pos = prompt.find(delimiter.delimiter, pos + delimiter.delimiter.size())) {
+            if (pos != 0) {
+                starts.push_back(pos);
+            }
+        }
+    }
+
+    std::sort(starts.begin(), starts.end());
+    starts.erase(std::unique(starts.begin(), starts.end()), starts.end());
+
+    llama_tokens result;
+    // Reserve initial capacity for the concatenated tokens; the vector grows
+    // as needed.
+    result.reserve(prompt.size() / 2);
+    auto & cache = get_chat_token_lru();
+
+    for (size_t i = 0; i < starts.size(); ++i) {
+        const size_t begin = starts[i];
+        const size_t end = i + 1 < starts.size() ? starts[i + 1] : prompt.size();
+        const bool segment_add_special = i == 0 && add_special;
+
+        std::string segment = prompt.substr(begin, end - begin);
+        std::string key;
+        key.reserve(segment.size() + 1);
+        key.push_back(segment_add_special ? '\1' : '\0');
+        key += segment;
+
+        llama_tokens tokens;
+        if (!cache.get(vocab, key, tokens)) {
+            tokens = common_tokenize(vocab, segment, segment_add_special, true);
+            cache.put(vocab, std::move(key), tokens);
+        }
+        result.insert(result.end(), tokens.begin(), tokens.end());
+    }
+
+    return result;
+}
