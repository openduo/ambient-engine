+
+// Fused transform/quantizer for PTQ1_0 MMQ. A CUDA block owns one Hadamard
+// block, keeps the butterflies in registers/shared memory, and quantizes the
+// final values directly.
+template <int N, bool has_gate, bool has_signs, bool pt_layout>
+__launch_bounds__(FWHT_BLOCK_THREADS, 1)
+__global__ void fwht_quantize_q8_1_cuda(
+        const float * src_ptr, const float * gate_ptr,
+        const float * signs_ptr, void * dst_ptr,
+        const int64_t n_fwht_rows, const int64_t blocks_per_token,
+        const int64_t tokens_per_channel, const float scale) {
+    // Launched with PDL: __restrict__ on the parameters would let loads move above ggml_cuda_pdl_sync()
+    // (https://github.com/ggml-org/llama.cpp/pull/24030); GGML_CUDA_RESTRICT drops it where PDL is active.
+    const float * GGML_CUDA_RESTRICT src   = src_ptr;
+    [[maybe_unused]] const float * GGML_CUDA_RESTRICT gate  = gate_ptr;
+    [[maybe_unused]] const float * GGML_CUDA_RESTRICT signs = signs_ptr;
+    void        * GGML_CUDA_RESTRICT dst   = dst_ptr;
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int NE = N / FWHT_BLOCK_THREADS;
+    static_assert(N % FWHT_BLOCK_THREADS == 0, "bad fused FWHT shape");
+
+    const int64_t r = blockIdx.x;
+    if (r >= n_fwht_rows) {
+        return;
+    }
+
+    const int tid  = threadIdx.x;
+    const int lane = tid % warp_size;
+    const int64_t token = r / blocks_per_token;
+    const int64_t block_in_token = r - token * blocks_per_token;
+    const int64_t base = token * (blocks_per_token * N) + block_in_token * N;
+
+    __shared__ float exchange[N];
+    float reg[NE];
+
+    ggml_cuda_pdl_sync();
+#pragma unroll
+    for (int j = 0; j < NE; ++j) {
+        const int k = j * FWHT_BLOCK_THREADS + tid;
+        float v = src[base + k];
+        if constexpr (has_gate) {
+            v *= ggml_cuda_op_silu_single(gate[base + k]);
+        }
+        if constexpr (has_signs) {
+            v *= signs[block_in_token * N + k];
+        }
+        reg[j] = v * scale;
+    }
+
+#pragma unroll
+    for (int h = 1; h < warp_size; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < NE; ++j) {
+            const float x = reg[j];
+            const float y = __shfl_xor_sync(0xFFFFFFFF, x, h, warp_size);
+            reg[j] = (lane & h) == 0 ? x + y : y - x;
+        }
+    }
+
+#pragma unroll
+    for (int h = warp_size; h < FWHT_BLOCK_THREADS; h *= 2) {
+#pragma unroll
+        for (int j = 0; j < NE; ++j) {
+            exchange[j * FWHT_BLOCK_THREADS + tid] = reg[j];
+        }
+        __syncthreads();
+#pragma unroll
+        for (int j = 0; j < NE; ++j) {
+            const float x = reg[j];
+            const float y = exchange[j * FWHT_BLOCK_THREADS + (tid ^ h)];
+            reg[j] = (tid & h) == 0 ? x + y : y - x;
+        }
+        __syncthreads();
+    }
+
+#pragma unroll
+    for (int h = FWHT_BLOCK_THREADS; h < N; h *= 2) {
+        const int step = h / FWHT_BLOCK_THREADS;
+#pragma unroll
+        for (int j = 0; j < NE; j += 2 * step) {
+#pragma unroll
+            for (int k = 0; k < step; ++k) {
+                const float x = reg[j + k];
+                const float y = reg[j + k + step];
+                reg[j + k]        = x + y;
+                reg[j + k + step] = x - y;
+            }
+        }
+    }
+
+    // PTQ1_0 uses the D4 MMQ layout: one float scale per 32 values and
+    // feature blocks transposed with token columns. The reduction is exactly
+    // the one used by quantize_mmq_q8_1, only the four values normally loaded
+    // by a thread are distributed over four consecutive lanes here.
+    const int64_t channel = token / tokens_per_channel;
+    const int64_t col     = token - channel * tokens_per_channel;
+    const int64_t qblocks_per_token = blocks_per_token * (N / QK8_1_MMQ);
+
+#pragma unroll
+    for (int j = 0; j < NE; ++j) {
+        float amax = fabsf(reg[j]);
+        float sum = reg[j];
+#pragma unroll
+        for (int offset = warp_size / 2; offset > 0; offset >>= 1) {
+            amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFF, amax, offset, warp_size));
+            if constexpr (pt_layout) {
+                sum += __shfl_xor_sync(0xFFFFFFFF, sum, offset, warp_size);
+            }
+        }
+
+        const int feature = (int) block_in_token * N + j * FWHT_BLOCK_THREADS + tid;
+        if constexpr (pt_layout) {
+            // MMVQ's PTQ1_0 path consumes a planar-transposed Q8_1 row.
+            // Quantize exactly as quantize_q8_1<true> does, including its
+            // division order and half2 (scale, sum), so the matvec input is
+            // the same as with a separate FWHT and quantize.
+            const float d = amax / 127.0f;
+            const int8_t q = amax == 0.0f ? 0 : roundf(reg[j] / d);
+            const int64_t features_per_token = blocks_per_token * N;
+            const int64_t nblk = features_per_token / QK_PTQ1_0;
+            const int kb = feature / QK_PTQ1_0;
+            const int e  = feature % QK_PTQ1_0;
+            char * ycol = (char *) dst + token * (features_per_token * 9 / 8);
+            ycol[((e / 16) * nblk + kb) * 16 + (e % 16)] = q;
+            if (lane == 0) {
+                half2 * ds = (half2 *) (ycol + 8 * nblk * 16) + kb * 4 + e / QK8_1;
+                *ds = make_half2(d, sum);
+            }
+        } else {
+            const float d_inv = 127.0f / amax;
+            const int8_t q = roundf(reg[j] * d_inv);
+            const float d = 1.0f / d_inv;
+            const int qblock = feature / QK8_1_MMQ;
+            const int iqs = feature % QK8_1_MMQ;
+            block_q8_1_mmq * out = (block_q8_1_mmq *) dst +
+                channel * (qblocks_per_token * tokens_per_channel) + qblock * tokens_per_channel + col;
+            out->qs[iqs] = q;
+            if (lane == 0) {
+                out->d4[iqs / QK8_1] = d;
+            }
+        }
+    }
+}
+
+template <int N, bool pt_layout>
+static void launch_fwht_quantize_q8_1(ggml_backend_cuda_context & ctx,
+        const float * src, const float * gate, const float * signs, void * dst,
+        int64_t rows, int64_t blocks_per_token, int64_t tokens_per_channel) {
+    const dim3 grid((unsigned) rows, 1, 1);
+    const dim3 block(FWHT_BLOCK_THREADS, 1, 1);
+    const float scale = 1.0f / sqrtf((float) N);
+    cudaStream_t stream = ctx.stream();
+
+#define LAUNCH_FWHT_Q8(G, S) \
+    ggml_cuda_kernel_launch((fwht_quantize_q8_1_cuda<N, G, S, pt_layout>), \
+        ggml_cuda_kernel_launch_params(grid, block, 0, stream), \
+        src, gate, signs, dst, rows, blocks_per_token, tokens_per_channel, scale)
+    if (gate) {
+        if (signs) { LAUNCH_FWHT_Q8(true, true);  }
+        else       { LAUNCH_FWHT_Q8(true, false); }
+    } else {
+        if (signs) { LAUNCH_FWHT_Q8(false, true);  }
+        else       { LAUNCH_FWHT_Q8(false, false); }
+    }
+#undef LAUNCH_FWHT_Q8
+}
+
+static bool quantize_fwht_q8_1(ggml_backend_cuda_context & ctx,
+                               const ggml_tensor * src, const ggml_tensor * gate,
+                               const ggml_tensor * signs, void * dst_q8, int n, bool pt_layout) {
+    if (!src || src->type != GGML_TYPE_F32 || !ggml_is_contiguous(src) ||
+            (gate && (gate->type != GGML_TYPE_F32 || !ggml_is_contiguous(gate) || !ggml_are_same_shape(src, gate))) ||
+            (signs && (signs->type != GGML_TYPE_F32 || !ggml_is_contiguous(signs) || signs->ne[0] != src->ne[0])) ||
+            src->ne[0] % n != 0 || src->ne[0] % QK8_1_MMQ != 0) {
+        return false;
+    }
+
+    const int64_t blocks_per_token = src->ne[0] / n;
+    const int64_t rows = ggml_nelements(src) / n;
+    const int64_t tokens_per_channel = src->ne[1];
+    const float * src_d = (const float *) src->data;
+    const float * gate_d = gate ? (const float *) gate->data : nullptr;
+    const float * signs_d = signs ? (const float *) signs->data : nullptr;
+
+#define FWHT_Q8_CASE(NN) \
+    case NN: \
+        if (pt_layout) { \
+            launch_fwht_quantize_q8_1<NN, true >(ctx, src_d, gate_d, signs_d, dst_q8, rows, blocks_per_token, tokens_per_channel); \
+        } else { \
+            launch_fwht_quantize_q8_1<NN, false>(ctx, src_d, gate_d, signs_d, dst_q8, rows, blocks_per_token, tokens_per_channel); \
+        } \
+        break
+    switch (n) {
+        FWHT_Q8_CASE(256);
+        FWHT_Q8_CASE(512);
+        FWHT_Q8_CASE(1024);
+        FWHT_Q8_CASE(2048);
+        FWHT_Q8_CASE(4096);
+        FWHT_Q8_CASE(8192);
+        default: return false;
+    }
+#undef FWHT_Q8_CASE
+    return true;
+}
+
+bool ggml_cuda_quantize_fwht_q8_1(ggml_backend_cuda_context & ctx,
+                                  const ggml_tensor * src, const ggml_tensor * gate,
+                                  const ggml_tensor * signs, void * dst_q8, int n) {
+    return quantize_fwht_q8_1(ctx, src, gate, signs, dst_q8, n, false);
+}
+
+bool ggml_cuda_quantize_fwht_q8_1_pt(ggml_backend_cuda_context & ctx,
+                                     const ggml_tensor * src, const ggml_tensor * gate,
+                                     const ggml_tensor * signs, void * dst_q8, int n) {
+    return quantize_fwht_q8_1(ctx, src, gate, signs, dst_q8, n, true);
+}
