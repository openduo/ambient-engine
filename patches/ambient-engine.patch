+void llama_memory_recurrent::journal_set_backends(const std::vector<ggml_backend_t> & backends) {
+    journal_backends = backends;
+}
+
+ggml_backend_t llama_memory_recurrent::journal_backend_for(const ggml_tensor * t) const {
+    const ggml_tensor * base = t->view_src != nullptr ? t->view_src : t;
+    GGML_ASSERT(base->buffer != nullptr);
+    ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(base->buffer);
+    for (ggml_backend_t backend : journal_backends) {
+        if (ggml_backend_supports_buft(backend, buft) && !ggml_backend_buffer_is_host(base->buffer)) {
+            return backend;
+        }
+    }
+    GGML_ABORT("%s: no backend to commit the recurrent journal on buffer type %s", __func__, ggml_backend_buft_name(buft));
+}
