+static bool penalties_cur_p_is_identity(
+        const llama_sampler_penalties * ctx,
+        const llama_token_data_array * cur_p) {
+    if (cur_p->size != static_cast<size_t>(ctx->n_vocab)) {
+        return false;
+    }
+
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        if (cur_p->data[i].id != static_cast<llama_token>(i)) {
+            return false;
+        }
+    }
+
