+void ggml_gated_delta_net_set_snapshot_indices(
+        struct ggml_tensor * gdn,
+        const int32_t      * indices,
+        int32_t              count) {
+    GGML_ASSERT(gdn->op == GGML_OP_GATED_DELTA_NET);
+    const int32_t K = ggml_get_op_params_i32(gdn, 0);
+    GGML_ASSERT(count == K);
+    // op params 0 and 1 are K and raw-gates; 2.. are the plane indices and the
+    // param after them flags custom mode. Every plane must be addressable,
+    // otherwise unaddressed planes would hold undefined data.
+    GGML_ASSERT(count <= GGML_GATED_DELTA_NET_MAX_SNAPSHOT_PLANES);
+    for (int32_t i = 0; i < count; ++i) {
+        ggml_set_op_params_i32(gdn, 2 + i, indices[i]);
+    }
+    for (int32_t i = count; i < GGML_GATED_DELTA_NET_MAX_SNAPSHOT_PLANES; ++i) {
+        ggml_set_op_params_i32(gdn, 2 + i, -1);
+    }
+    ggml_set_op_params_i32(gdn, 2 + GGML_GATED_DELTA_NET_MAX_SNAPSHOT_PLANES, 1);
+}
+
+int64_t ggml_gated_delta_net_journal_entry_size(int64_t S_v, int64_t H_k, int64_t H_v) {
+    return S_v * H_k + S_v * H_v + H_v;
+}
+
+// Shared by the two journal constructors: the arguments are checked as in
+// ggml_gated_delta_net / ggml_gated_delta_net_rows_commit with K = 1.
+static struct ggml_tensor * ggml_gated_delta_net_journal_impl(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * states,
+        struct ggml_tensor  * read_rows,
+        struct ggml_tensor  * write_states,
+        int                   n_journal) {
+    GGML_ASSERT(ggml_is_contiguous_rows(q));
+    GGML_ASSERT(ggml_is_contiguous_rows(k));
+    GGML_ASSERT(ggml_is_contiguous_rows(v));
+    GGML_ASSERT(ggml_is_contiguous(g));
+    GGML_ASSERT(ggml_is_contiguous(beta));
+    GGML_ASSERT(ggml_is_contiguous(states));
+
+    GGML_ASSERT(q->type == GGML_TYPE_F32);
+    GGML_ASSERT(k->type == GGML_TYPE_F32);
+    GGML_ASSERT(v->type == GGML_TYPE_F32);
+    GGML_ASSERT(g->type == GGML_TYPE_F32);
+    GGML_ASSERT(beta->type == GGML_TYPE_F32);
+    GGML_ASSERT(states->type == GGML_TYPE_F32);
+
+    const int64_t S_v      = v->ne[0];
+    const int64_t H        = v->ne[1];
+    const int64_t n_tokens = v->ne[2];
+    const int64_t n_seqs   = v->ne[3];
+
+    GGML_ASSERT(n_journal >= 1);
+    GGML_ASSERT(g->ne[0] == 1); // scalar gate only
+    GGML_ASSERT(beta->ne[0] == 1);
+    GGML_ASSERT(k->ne[0] == S_v && H % k->ne[1] == 0);
+
+    int64_t state_rows = 0;
+    if (read_rows == NULL) {
+        // gathered input state [S_v, S_v, H, n_seqs]; the base state is one slot of the output
+        GGML_ASSERT(states->ne[0] == S_v && states->ne[1] == S_v && states->ne[2] == H && states->ne[3] == n_seqs);
+        state_rows = S_v * n_seqs;
+    } else {
+        GGML_ASSERT(ggml_is_contiguous(read_rows));
+        GGML_ASSERT(read_rows->type == GGML_TYPE_I32);
+        GGML_ASSERT(write_states != NULL && write_states->type == GGML_TYPE_F32);
+        GGML_ASSERT(ggml_is_contiguous_rows(write_states));
+        GGML_ASSERT(states->ne[0] == S_v * S_v * H);
+        GGML_ASSERT(read_rows->ne[0] == n_seqs);
+        GGML_ASSERT(write_states->ne[0] == S_v * S_v * H);
+        GGML_ASSERT(write_states->ne[1] == n_seqs);
+        GGML_ASSERT(write_states->ne[2] == 1);
+    }
+
+    // journal floats, padded to whole rows of width S_v*H
+    const int64_t n_jrnl = (int64_t) n_journal * ggml_gated_delta_net_journal_entry_size(S_v, k->ne[1], H) * n_seqs;
+    const int64_t journal_rows = (n_jrnl + S_v * H - 1) / (S_v * H);
+
+    const int64_t ne[4] = { S_v * H, n_tokens * n_seqs + state_rows + journal_rows, 1, 1 };
+    struct ggml_tensor * result = ggml_new_tensor(ctx, GGML_TYPE_F32, 4, ne);
+
+    ggml_set_op_params_i32(result, 0, 1); // K: the base state is the only state slot
+    ggml_set_op_params_i32(result, GGML_GATED_DELTA_NET_JOURNAL_PARAM, n_journal);
+
+    result->op     = GGML_OP_GATED_DELTA_NET;
+    result->src[0] = q;
+    result->src[1] = k;
+    result->src[2] = v;
+    result->src[3] = g;
+    result->src[4] = beta;
+    result->src[5] = states;
+    result->src[6] = read_rows;
+    result->src[9] = write_states;
+
+    return result;
+}
+
+struct ggml_tensor * ggml_gated_delta_net_journal(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * state,
+        int                   n_journal) {
+    return ggml_gated_delta_net_journal_impl(ctx, q, k, v, g, beta, state, NULL, NULL, n_journal);
+}
+
+struct ggml_tensor * ggml_gated_delta_net_rows_commit_journal(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * q,
+        struct ggml_tensor  * k,
+        struct ggml_tensor  * v,
+        struct ggml_tensor  * g,
+        struct ggml_tensor  * beta,
+        struct ggml_tensor  * states,
+        struct ggml_tensor  * read_rows,
+        struct ggml_tensor  * write_states,
+        int                   n_journal) {
+    GGML_ASSERT(read_rows != NULL);
+    return ggml_gated_delta_net_journal_impl(ctx, q, k, v, g, beta, states, read_rows, write_states, n_journal);
+}
+
+size_t ggml_gated_delta_net_journal_offset(const struct ggml_tensor * gdn) {
+    GGML_ASSERT(gdn->op == GGML_OP_GATED_DELTA_NET);
+    GGML_ASSERT(ggml_get_op_params_i32(gdn, GGML_GATED_DELTA_NET_JOURNAL_PARAM) > 0);
+
+    const struct ggml_tensor * v = gdn->src[2];
+    const int64_t S_v      = v->ne[0];
+    const int64_t H        = v->ne[1];
+    const int64_t n_tokens = v->ne[2];
+    const int64_t n_seqs   = v->ne[3];
+    const int64_t K        = ggml_get_op_params_i32(gdn, 0);
+
+    // attention scores, then the state slots unless they go to write_states (src[9])
+    const int64_t state_tail = gdn->src[9] != NULL ? 0 : K * S_v * S_v * H * n_seqs;
+    return (size_t) (S_v * H * n_tokens * n_seqs + state_tail);
+}
+
+struct ggml_tensor * ggml_gated_delta_net_commit(
+        struct ggml_context * ctx,
+        struct ggml_tensor  * states,
+        struct ggml_tensor  * journal,
+        struct ggml_tensor  * plan,
+        int64_t               S_v,
+        int64_t               H_k,
+        int64_t               H_v,
+        int                   n_journal,
+        int                   count) {
+    GGML_ASSERT(states->type == GGML_TYPE_F32);
+    GGML_ASSERT(journal->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_contiguous_rows(states));
+    GGML_ASSERT(ggml_is_contiguous_rows(journal));
+    GGML_ASSERT(states->ne[0] == S_v * S_v * H_v);
+    GGML_ASSERT(journal->ne[0] == n_journal * ggml_gated_delta_net_journal_entry_size(S_v, H_k, H_v));
+    GGML_ASSERT(n_journal >= 1 && H_v % H_k == 0);
+    GGML_ASSERT(plan == NULL || (plan->type == GGML_TYPE_I32 && ggml_is_contiguous(plan) && plan->ne[0] % 2 == 0));
+    GGML_ASSERT(plan != NULL || (count >= 0 && count <= n_journal));
+
+    struct ggml_tensor * result = ggml_view_tensor(ctx, states);
+
+    ggml_set_op_params_i32(result, 0, (int32_t) S_v);
+    ggml_set_op_params_i32(result, 1, (int32_t) H_k);
+    ggml_set_op_params_i32(result, 2, (int32_t) H_v);
+    ggml_set_op_params_i32(result, 3, n_journal);
+    ggml_set_op_params_i32(result, 4, count);
+
+    result->op     = GGML_OP_GATED_DELTA_NET_COMMIT;
+    result->src[0] = states;
+    result->src[1] = journal;
+    result->src[2] = plan;
+
+    return result;
+}
+
+void ggml_gated_delta_net_commit_set_count(struct ggml_tensor * commit, int count) {
+    GGML_ASSERT(commit->op == GGML_OP_GATED_DELTA_NET_COMMIT && commit->src[2] == NULL);
+    GGML_ASSERT(count >= 0 && count <= ggml_get_op_params_i32(commit, 3));
+    ggml_set_op_params_i32(commit, 4, count);
+}
