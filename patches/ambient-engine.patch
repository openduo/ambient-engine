+void llama_context::set_state_snapshots(
+        llama_seq_id seq_id, const llama_pos * positions, size_t count) {
+    auto * recurrent = llama_get_recurrent_memory(memory.get());
+    if (recurrent == nullptr) {
+        return;
+    }
+    // Unsupported: request nothing, so every position reports not captured.
+    if (n_state_snapshots() == 0) {
+        recurrent->set_state_snapshots(seq_id, nullptr, 0);
+        return;
+    }
+    if (!recurrent->journal) {
+        recurrent->set_state_snapshots(seq_id, positions, count);
+        return;
+    }
+
+    // Journal: the snapshots go to checkpoint buffers instead of rollback planes.
+    // Buffers of an earlier decode, and an earlier request of this sequence, end here.
+    state_staging_release(-1, true);
+    state_staging_release(seq_id, false);
+
+    const size_t n_req = positions != nullptr ? std::min<size_t>(count, n_state_snapshots()) : 0;
+    std::vector<llama_memory_recurrent::state_snapshot_dst> dsts;
+    for (size_t i = 0; i < n_req; ++i) {
+        state_staging st;
+        st.seq_id = seq_id;
+        st.slot   = (uint32_t) i;
+        llama_memory_recurrent::state_snapshot_dst dst;
+        if (!state_staging_make(recurrent, seq_id, st.bufs, dst)) {
+            // only the positions with a buffer are requested
+            LLAMA_LOG_WARN("%s: no device memory for in-pass snapshot %zu of seq %d; it is not captured\n",
+                    __func__, i, seq_id);
+            break;
+        }
+        state_stagings.push_back(std::move(st));
+        dsts.push_back(std::move(dst));
+    }
+
+    const size_t n_dst = dsts.size();
+    recurrent->set_state_snapshot_dsts(seq_id, std::move(dsts));
+    recurrent->set_state_snapshots(seq_id, n_dst > 0 ? positions : nullptr, n_dst);
+}
+
+bool llama_context::state_staging_make(llama_memory_recurrent * mem, llama_seq_id seq_id,
+        llama_memory_buffers & bufs, llama_memory_recurrent::state_snapshot_dst & dst) {
+    // The layout a device checkpoint of one cell gets from llama_io_write_device:
+    // per buffer type, the R rows of every layer, then the S rows, as 1D copies.
+    const int32_t n_layer = (int32_t) mem->r_l.size();
+    const int32_t tail = seq_id >= 0 && (uint32_t) seq_id < mem->size ? mem->cells[seq_id].tail : -1;
+    const size_t  cell = tail >= 0 ? (size_t) tail : 0;
+
+    dst.r.assign(n_layer, nullptr);
+    dst.s.assign(n_layer, nullptr);
+
+    llama_memory_buffers layout;
+    struct entry { ggml_tensor * t; size_t offs; size_t size; bool is_r; int32_t il; };
+    std::vector<entry> entries;
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (mem->r_l[il] != nullptr) {
+            entries.push_back({ mem->r_l[il], cell*mem->r_l[il]->nb[1], mem->r_l[il]->nb[1], true, il });
+        }
+    }
+    for (int32_t il = 0; il < n_layer; ++il) {
+        if (mem->s_l[il] != nullptr) {
+            entries.push_back({ mem->s_l[il], cell*mem->s_l[il]->nb[1], mem->s_l[il]->nb[1], false, il });
+        }
+    }
+    for (const auto & e : entries) {
+        auto & mbuf = layout[ggml_backend_buffer_get_type(e.t->buffer)];
+        mbuf.n_tensors++;
+        mbuf.total_size += e.size;
+    }
+
+    // A free pool entry with this layout lends its buffer.
+    for (const llama_seq_id id : device_state_free) {
+        auto & cand = mem_storage[id];
+        bool same = cand.size() == layout.size();
+        for (auto it = layout.begin(); same && it != layout.end(); ++it) {
+            const auto c = cand.find(it->first);
+            same = c != cand.end() && c->second.buf && c->second.n_tensors == it->second.n_tensors &&
+                c->second.total_size == it->second.total_size && (int) c->second.cpy.size() == it->second.n_tensors;
+        }
+        if (!same) {
+            continue;
+        }
+        // cpy tensors are in write order, so they map to the entries one to one
+        std::map<ggml_backend_buffer_type_t, size_t> next;
+        for (const auto & e : entries) {
+            auto & mbuf = cand[ggml_backend_buffer_get_type(e.t->buffer)];
+            ggml_tensor * t = mbuf.cpy[next[ggml_backend_buffer_get_type(e.t->buffer)]++];
+            if (ggml_nbytes(t) != e.size) {
+                same = false;
+                break;
+            }
+            (e.is_r ? dst.r : dst.s)[e.il] = t;
+        }
+        if (!same) {
+            dst.r.assign(n_layer, nullptr);
+            dst.s.assign(n_layer, nullptr);
+            continue;
+        }
+        bufs = std::move(cand);
+        cand.clear();
+        return true;
+    }
+
+    // Otherwise a new buffer, built as llama_io_write_device builds one.
+    for (auto & [buft, mbuf] : layout) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ 2*mbuf.n_tensors*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        mbuf.ctx.reset(ggml_init(params));
+        mbuf.org.reserve(mbuf.n_tensors);
+        mbuf.cpy.reserve(mbuf.n_tensors);
+    }
+    for (const auto & e : entries) {
+        auto & mbuf = layout[ggml_backend_buffer_get_type(e.t->buffer)];
+        const int64_t n = e.size/ggml_element_size(e.t);
+        mbuf.org.push_back(ggml_view_1d      (mbuf.ctx.get(), e.t, n, e.offs));
+        mbuf.cpy.push_back(ggml_new_tensor_1d(mbuf.ctx.get(), e.t->type, n));
+        (e.is_r ? dst.r : dst.s)[e.il] = mbuf.cpy.back();
+    }
+    for (auto & [buft, mbuf] : layout) {
+        mbuf.buf.reset(ggml_backend_alloc_ctx_tensors_from_buft(mbuf.ctx.get(), buft));
+        if (!mbuf.buf) {
+            dst.r.clear();
+            dst.s.clear();
+            return false;
+        }
+    }
+    bufs = std::move(layout);
+    return true;
+}
+
+void llama_context::state_staging_release(llama_seq_id seq_id, bool filled_only) {
+    auto * recurrent = llama_get_recurrent_memory(memory.get());
+    for (auto it = state_stagings.begin(); it != state_stagings.end();) {
+        if ((seq_id >= 0 && it->seq_id != seq_id) || (filled_only && !it->filled)) {
+            ++it;
+            continue;
+        }
+        if (recurrent != nullptr) {
+            recurrent->clear_state_snapshot_dsts(it->seq_id);
+        }
+        // a pool entry left without a buffer takes it back; otherwise it is freed
+        if (!it->bufs.empty()) {
+            for (const llama_seq_id id : device_state_free) {
+                auto & cand = mem_storage[id];
+                if (cand.empty()) {
+                    cand = std::move(it->bufs);
+                    break;
+                }
+            }
+        }
+        it = state_stagings.erase(it);
+    }
+}
